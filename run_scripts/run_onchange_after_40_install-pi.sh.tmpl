#!/bin/bash
set -euo pipefail

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
# Install pi after the fnm/Node bootstrap has run.
# The official curl installer uses npm globally; install the npm package
# directly here so the chezmoi step stays auditable and non-interactive.

BOOTSTRAP_LIB="${HOME}/.local/lib/dotfiles/bootstrap-shell.sh"
[ -r "${BOOTSTRAP_LIB}" ] || { echo "error: missing ${BOOTSTRAP_LIB}" >&2; exit 1; }
# shellcheck source=/dev/null
source "${BOOTSTRAP_LIB}"
dotfiles_load_node {{ .toolchains.node.version | quote }}

echo "Installing pinned pi coding agent release..."
npm install -g --ignore-scripts @earendil-works/pi-coding-agent@{{ .toolchains.pi.version }}

pi --version >/dev/null
{{ else -}}
echo "Skipping pi install: unsupported OS {{ .chezmoi.os }}."
{{ end -}}
